{
  "name": "db-readonly-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing guarded, read-only SQL access to a Postgres database.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "sql",
    "readonly",
    "claude"
  ],
  "author": "David Mogbeyiteren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-mogbeyi/db-readonly-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/david-mogbeyi/db-readonly-mcp/issues"
  },
  "homepage": "https://github.com/david-mogbeyi/db-readonly-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
